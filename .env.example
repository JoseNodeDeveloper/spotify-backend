# Copy this file to .env and fill in the values. The .env file is NEVER committed to the repository.

NODE_ENV=development
PORT=3000
# Allowed CORS origins, comma-separated
CORS_ORIGINS=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=spotify_albums
DB_USER=app
DB_PASSWORD=change-this-password

# At least 32 random characters. Generate one with: openssl rand -base64 48
JWT_SECRET=
# Token lifetime in seconds (15 minutes)
JWT_EXPIRES_IN=900

# Credentials from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
